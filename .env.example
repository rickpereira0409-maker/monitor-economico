# ===== Obrigatórias em produção =====
NODE_ENV=production
ACCESS_PASSWORD=troque-por-uma-senha-forte-com-12+-caracteres
SESSION_SECRET=gere-com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Atrás de proxy HTTPS (Render, Fly, Caddy, Nginx): true para usar o IP real no limite de login
TRUST_PROXY=true
# URL pública (usada nos links dos e-mails/Telegram)
PUBLIC_URL=https://monitor.seudominio.com.br

# ===== Servidor e banco =====
PORT=3000
DB_PATH=/data/monitor.db        # precisa estar em disco persistente

# ===== Frequência das coletas (minutos) =====
FX_MARKET_INTERVAL_MIN=5
FX_PTAX_INTERVAL_MIN=30
NEWS_INTERVAL_MIN=20
LEGISLATION_INTERVAL_MIN=60
ALERTS_INTERVAL_MIN=1

# ===== Opcionais =====
AWESOMEAPI_KEY=                 # funciona sem chave; chave não foi testada aqui
SMTP_HOST=                      # e-mail: preencha tudo para habilitar
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Monitor <alertas@seudominio.com.br>"
TELEGRAM_BOT_TOKEN=             # token do @BotFather
